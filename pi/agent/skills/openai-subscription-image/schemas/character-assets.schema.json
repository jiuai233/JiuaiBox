{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {
      "type": "object",
      "required": ["asset_id", "name", "appearance", "invariants", "wardrobe", "anchors", "simulation"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "appearance": {"type": "string", "minLength": 1},
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "wardrobe": {"type": "string", "minLength": 1},
        "anchors": {
          "type": "array", "items": {
            "type": "object", "required": ["role", "path", "sha256"],
            "properties": {"role": {"type": "string"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}},
            "additionalProperties": false
          }
        },
        "simulation": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object", "required": ["task_mode"],
      "properties": {
        "task_mode": {"enum": ["text_to_image", "edit", "reference_compose"]},
        "references": {
          "type": "array", "items": {
            "type": "object", "required": ["id", "path", "role"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "not": {"const": "discard"}},
              "path": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "origin": {"enum": ["observed", "3d-defined", "estimated", "designed", "generated"]},
              "sha256": {"$ref": "#/$defs/digest"},
              "metadata_path": {"type": "string", "minLength": 1},
              "metadata_sha256": {"$ref": "#/$defs/digest"}
            },
            "dependentRequired": {"metadata_sha256": ["metadata_path"]},
            "additionalProperties": false
          }
        },
        "attribute_sources": {
          "type": "object", "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "preserve": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "creative_freedom": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"task_mode": {"const": "text_to_image"}}},
          "then": {"properties": {"references": {"maxItems": 0}}},
          "else": {"required": ["references"], "properties": {"references": {"minItems": 1}}}
        }
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object", "required": [],
      "properties": {
        "role": {"type": "string"},
        "provider": {"type": "string", "minLength": 1},
        "input_anchor_roles": {"type": "array", "items": {"type": "string"}},
        "deliverable": {"type": "string"},
        "prompt": {"type": "string"},
        "prompt_mode": {"enum": ["authored", "legacy"]},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "generation": {"$ref": "#/$defs/generation"}
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object", "required": ["asset_id", "template_id", "identity_sha256", "tasks"],
      "properties": {
        "asset_id": {"type": "string"}, "template_id": {"type": "string"},
        "identity_sha256": {"$ref": "#/$defs/digest"},
        "tasks": {
          "type": "array",
          "items": {"allOf": [{"$ref": "#/$defs/task"}], "required": ["role"]}
        }
      },
      "additionalProperties": false
    },
    "attachment": {
      "type": "object", "required": ["id", "kind", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["native-scene", "configuration", "control-image", "depth-array", "generation-record", "source-code", "documentation", "manifest"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "pack": {
      "type": "object",
      "required": ["asset_id", "revision", "media"],
      "properties": {
        "asset_id": {"type": "string"}, "revision": {"type": "string", "pattern": "^r[0-9]{4,}$"},
        "template_id": {"type": "string"},
        "identity_sha256": {"$ref": "#/$defs/digest"}, "plan_sha256": {"$ref": "#/$defs/digest"},
        "simulation": {"type": "boolean"},
        "attachments": {"type": "array", "items": {"$ref": "#/$defs/attachment"}},
        "media": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "roles", "path", "sha256", "provider", "provenance"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
              "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"},
              "provider": {"type": "string", "minLength": 1},
              "provenance": {
                "type": "object", "required": ["source_ref"],
                "properties": {
                  "source_ref": {"type": "string", "minLength": 1},
                  "job_id": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]},
                  "requested_parameters": {"type": "object"}, "returned_parameters": {"type": "object"},
                  "rights_notes": {"type": "string"}
                },
                "additionalProperties": false
              },
              "content_review": {
                "type": "object", "required": ["verdict", "reviewer", "notes"],
                "properties": {
                  "verdict": {"enum": ["pass", "fail", "pending"]},
                  "reviewer": {"type": "string", "minLength": 1}, "notes": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object", "required": ["asset_id", "revision", "library_release", "release_sha256"],
      "properties": {
        "asset_id": {"type": "string"}, "revision": {"type": "string"},
        "library_release": {"type": "string"}, "release_sha256": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  }
}
